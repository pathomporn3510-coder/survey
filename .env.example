# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local ขึ้น Git)
# ค่าทั้งหมดหาได้ที่ Supabase Dashboard > Project Settings > API (หรือปุ่ม Connect)

# URL ของโปรเจกต์ Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# ใส่อย่างใดอย่างหนึ่ง:
#  - Publishable key (รูปแบบใหม่ ขึ้นต้นด้วย sb_publishable_...)  หรือ
#  - anon key (รูปแบบเดิม เป็น JWT ยาว ๆ)
# คีย์นี้เปิดเผยได้ เพราะสิทธิ์ถูกจำกัดด้วย Row Level Security
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ลิงก์เข้าสู่ระบบลา (ไม่บังคับ — ถ้าเว้นว่างจะแสดง "รอเพิ่มลิงก์ระบบลา")
NEXT_PUBLIC_LEAVE_SYSTEM_URL=

# หมายเหตุ: โปรเจกต์นี้ "ไม่ใช้" SUPABASE_SERVICE_ROLE_KEY
# ทุกการอ่าน/เขียนผ่านคีย์สาธารณะ + RLS เท่านั้น อย่าใส่ Service Role Key ในตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_
